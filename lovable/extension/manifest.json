{
  "manifest_version": 3,
  "name": "ApplyPilot Agent",
  "version": "1.0.0",
  "description": "Applies to the jobs queued in your ApplyPilot panel, in your own browser.",
  "permissions": ["storage", "tabs", "scripting", "alarms", "notifications"],
  "host_permissions": [
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.ashbyhq.com/*",
    "https://*.workable.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.icims.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.jobvite.com/*",
    "https://*.bamboohr.com/*",
    "https://*.supabase.co/*",
    "https://*/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "ApplyPilot" },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": { "128": "icon128.png" }
}
