# ApplyPilot Environment Configuration
# Copy to ~/.applypilot/.env and fill in your values.

# ---------------------------------------------------------------------------
# LLM Provider (pick one) — required for scoring, tailoring, cover letters
# ---------------------------------------------------------------------------
# Gemini's free tier needs NO credit card. Exceeding the daily limit returns
# an HTTP 429 ("try tomorrow") — it never bills you.
#
# WARNING: do NOT click "Enable billing" on that Google account. Doing so
# DELETES the free tier — every call becomes billable, with no free
# allowance. The free tier only stays free while billing is off.
GEMINI_API_KEY=           # Free at aistudio.google.com — recommended
# OPENAI_API_KEY=         # OpenAI (GPT-4o-mini) — this one DOES cost money
# LLM_URL=http://127.0.0.1:8080/v1  # Local model (Ollama/llama.cpp): truly
#                                   # unlimited, no quota, no account needed
# LLM_MODEL=              # Override model name

# Volume tuning (see docs/VOLUME.md)
SCORE_BATCH_SIZE=15        # jobs scored per request; 20 in --volume mode
COVER_LETTER_MODE=high     # all | high | off  — 'off' frees ~280 req/day
COVER_LETTER_MIN_SCORE=8   # with mode=high, only letters for this score and up

# Daily request cap. Not dollars — a count of API calls, used to stop cleanly
# before hitting the free tier's ~1,500/day ceiling instead of stalling in
# rate-limit backoff. Ignored entirely when LLM_URL is set (local = no quota).
# LLM_DAILY_BUDGET=1400

# ---------------------------------------------------------------------------
# Mission Control panel bridge (applypilot sync)
# Both from Supabase -> Settings -> API. The service_role key stays on this
# machine and must never appear in frontend code.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------------------
# Email ingestion (applypilot mail) — powers the Inbox and outcome tracking
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords  (read-only use)
# ---------------------------------------------------------------------------
MAIL_ADDRESS=
MAIL_APP_PASSWORD=
# MAIL_IMAP_HOST=imap.gmail.com   # default; change for non-Gmail

# ---------------------------------------------------------------------------
# USAJobs API (optional, free) — every US federal opening
# Register at https://developer.usajobs.gov/APIRequest
# ---------------------------------------------------------------------------
# USAJOBS_API_KEY=
# USAJOBS_EMAIL=

# ---------------------------------------------------------------------------
# Optional extras
# ---------------------------------------------------------------------------
CAPSOLVER_API_KEY=        # Paid. Without it, CAPTCHAs go to the Attention Queue
# PROXY=host:port:user:pass
